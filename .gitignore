*.duckdb.wal
*.duckdb.tmp
*.duckdb.bak
*.duckdb-shm
*.duckdb-wal

# Backups genericos
*.bak
*.backup
*.old
*.orig

# =============================================================================
# Outputs geoespaciais grandes
# =============================================================================
*.fgb
*.parquet
*.geoparquet
!tests/**/*.parquet

# GeoJSONs pequenos (AOIs) sao versionados; grandes de output ficam de fora
webmap/data/*.geojson
webmap/data/*.json
webmap/index.html
webmap/*.html

# =============================================================================
# Webmap gerado (mantido no repo, mas assets pesados fora)
# =============================================================================
webmap/tiles/
webmap/*.html.bak

