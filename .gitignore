# =============================================================================
# Dados brutos e processados (grandes demais para git; regenerar via CLI)
# =============================================================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# AOIs (GeoJSONs pequenos) sao versionadas; outros formatos pesados ficam de fora
data/external/aois/*.gpkg
data/external/aois/*.shp
data/external/aois/*.shx
data/external/aois/*.dbf
data/external/aois/*.prj
data/external/aois/*.cpg
data/external/aois/*.qmd

