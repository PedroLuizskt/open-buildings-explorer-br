# =============================================================================
# open-buildings-explorer-br — Variaveis de ambiente
# =============================================================================
# Este arquivo eh um TEMPLATE. Copie para .env (nao versionado) e ajuste.
# Nao ha credenciais obrigatorias — o bucket S3 usado eh publico.
# =============================================================================

# -----------------------------------------------------------------------------
# S3 e bucket publico do dataset
# -----------------------------------------------------------------------------
# Bucket VIDA (Google-Microsoft Open Buildings). Nao ha razao para mudar
# a menos que o VIDA republique em outro endereco.
OBR_S3_BUCKET_URL=s3://us-west-2.opendata.source.coop/vida/google-microsoft-open-buildings/geoparquet

# Bucket original do Google (usado apenas na Fase B para comparacoes).
OBR_S3_GOOGLE_URL=s3://us-west-2.opendata.source.coop/google-research-open-buildings/geoparquet-by-country

# Regiao AWS. O bucket esta em us-west-2 (Oregon).
OBR_S3_REGION=us-west-2

# -----------------------------------------------------------------------------
# Defaults de execucao
# -----------------------------------------------------------------------------
# Codigo ISO do pais para consultas default.
OBR_DEFAULT_COUNTRY_ISO=BRA

# AOI default quando nenhuma eh especificada na CLI.
OBR_DEFAULT_AOI=cambuquira_mg

# Nivel de log (DEBUG, INFO, WARNING, ERROR).
OBR_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Diretorios (opcional — defaults sao data/raw, data/processed, webmap)
# -----------------------------------------------------------------------------
# Descomentar apenas se quiser sobrescrever os defaults.
# OBR_DATA_RAW_DIR=data/raw
# OBR_DATA_PROCESSED_DIR=data/processed
# OBR_WEBMAP_DIR=webmap
